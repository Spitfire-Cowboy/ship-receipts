{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofofship.com/schemas/ship-receipts.v1.schema.json",
  "title": "Ship Receipts v1",
  "type": "object",
  "required": ["version", "subject", "artifacts"],
  "properties": {
    "version": {"enum": ["0.1", "1.0", "1.1"]},
    "receipt_id": {
      "type": "string",
      "description": "Stable identifier for this receipt (e.g. urn, UUID, slug)."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this receipt was issued."
    },
    "agent": {
      "type": "string",
      "description": "Agent name that minted this receipt."
    },
    "agent_calibration_score": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Rolling Brier score at mint time (lower is better)."
    },
    "agent_predictions_n": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Number of predictions used in calibration window."
    },
    "shot_call_confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Agent confidence before verification result is known."
    },
    "verification_result": {
      "type": "string",
      "enum": ["pass", "fail", "skipped"],
      "description": "Verification result captured at mint time."
    },
    "dr_signal": {
      "type": ["string", "null"],
      "enum": ["SHIP", "CONTINUE", "ESCALATE", null],
      "description": "Diminishing-returns signal at mint time."
    },
    "commit": {
      "type": ["string", "null"],
      "description": "Git commit hash captured when minting."
    },
    "ts": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Mint timestamp in UTC."
    },

    "meta": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "schema_version": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },

    "subject": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "url"],
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "url": {"type": "string", "format": "uri"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },

    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "name", "url"],
        "properties": {
          "kind": {"type": "string", "enum": ["repo", "release", "package", "dataset", "paper", "demo", "disclosure", "community_contribution", "wellness", "session_replay", "other"]},
          "name": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "version": {"type": "string"},
          "immutable_ref": {"type": "string", "description": "commit SHA, digest, etc."},
          "ci_url": {"type": "string", "format": "uri"},
          "verify": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": {"type": "string", "enum": ["command", "checksum", "note", "link", "attestation"]},
                "command": {"type": "string"},
                "algo": {"type": "string"},
                "hash": {"type": "string"},
                "url": {"type": "string", "format": "uri"},
                "note": {"type": "string"},
                "attestation": {"type": "object", "additionalProperties": true},
                "source": {"type": "string", "description": "Who/what produced this verification entry."},
                "observed_at": {"type": "string", "format": "date-time"}
              },
              "additionalProperties": true
            }
          },
          "claims": {
            "type": "array",
            "description": "Structured claims with attribution to reduce unverifiable marketing metrics.",
            "items": {
              "type": "object",
              "required": ["name", "value"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "value": {"type": ["string", "number", "boolean"]},
                "unit": {"type": "string"},
                "source_url": {"type": "string", "format": "uri"},
                "observed_at": {"type": "string", "format": "date-time"},
                "methodology": {"type": "string"}
              },
              "additionalProperties": true
            }
          },
          "provenance": {
            "type": "object",
            "description": "Optional supply-chain provenance pointers for stronger trust.",
            "properties": {
              "source_repo": {"type": "string", "format": "uri"},
              "commit": {"type": "string"},
              "builder": {"type": "string"},
              "build_type": {"type": "string"},
              "slsa_level": {"type": "string", "enum": ["L1", "L2", "L3", "L4"]},
              "sbom_url": {"type": "string", "format": "uri"},
              "in_toto_statement_url": {"type": "string", "format": "uri"},
              "sigstore_bundle_url": {"type": "string", "format": "uri"},
              "transparency_log_url": {"type": "string", "format": "uri"},
              "verified_at": {"type": "string", "format": "date-time"}
            },
            "additionalProperties": true
          },
          "signals": {
            "type": "object",
            "properties": {
              "dependents": {"type": "integer", "minimum": 0},
              "downloads_30d": {"type": "integer", "minimum": 0},
              "stars": {"type": "integer", "minimum": 0},
              "downstream_citations": {"type": "array", "items": {"type": "string"}},
              "as_of": {"type": "string", "format": "date-time"},
              "sources": {"type": "array", "items": {"type": "string", "format": "uri"}},
              "methodology": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },

    "issuer": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "url": {"type": "string", "format": "uri"}
      },
      "additionalProperties": true
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
