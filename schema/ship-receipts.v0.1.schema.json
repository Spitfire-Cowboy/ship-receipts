{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofofship.com/schemas/ship-receipts.v0.1.schema.json",
  "title": "Ship Receipts v0.1",
  "type": "object",
  "required": ["version", "subject", "artifacts"],
  "properties": {
    "version": {"const": "0.1"},
    "receipt_id": {
      "type": "string",
      "description": "Stable identifier for this receipt (e.g. urn, UUID, slug)."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this receipt was issued."
    },

    "subject": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "url"],
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "url": {"type": "string", "format": "uri"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },

    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "name", "url"],
        "properties": {
          "kind": {"type": "string", "enum": ["repo", "release", "package", "dataset", "paper", "demo", "disclosure", "community_contribution", "wellness", "session_replay", "other"]},
          "name": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "version": {"type": "string"},
          "immutable_ref": {"type": "string", "description": "commit SHA, digest, etc."},
          "ci_url": {"type": "string", "format": "uri"},
          "verify": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": {"type": "string", "enum": ["command", "checksum", "note", "link", "attestation"]},
                "command": {"type": "string"},
                "algo": {"type": "string"},
                "hash": {"type": "string"},
                "url": {"type": "string", "format": "uri"},
                "note": {"type": "string"},
                "attestation": {"type": "object", "additionalProperties": true},
                "source": {"type": "string", "description": "Who/what produced this verification entry."},
                "observed_at": {"type": "string", "format": "date-time"}
              },
              "additionalProperties": true
            }
          },
          "claims": {
            "type": "array",
            "description": "Structured claims with attribution to reduce unverifiable marketing metrics.",
            "items": {
              "type": "object",
              "required": ["name", "value"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "value": {"type": ["string", "number", "boolean"]},
                "unit": {"type": "string"},
                "source_url": {"type": "string", "format": "uri"},
                "observed_at": {"type": "string", "format": "date-time"},
                "methodology": {"type": "string"}
              },
              "additionalProperties": true
            }
          },
          "provenance": {
            "type": "object",
            "description": "Optional supply-chain provenance pointers for stronger trust.",
            "properties": {
              "source_repo": {"type": "string", "format": "uri"},
              "commit": {"type": "string"},
              "builder": {"type": "string"},
              "build_type": {"type": "string"},
              "slsa_level": {"type": "string", "enum": ["L1", "L2", "L3", "L4"]},
              "sbom_url": {"type": "string", "format": "uri"},
              "in_toto_statement_url": {"type": "string", "format": "uri"},
              "sigstore_bundle_url": {"type": "string", "format": "uri"},
              "transparency_log_url": {"type": "string", "format": "uri"},
              "verified_at": {"type": "string", "format": "date-time"}
            },
            "additionalProperties": true
          },
          "signals": {
            "type": "object",
            "properties": {
              "dependents": {"type": "integer", "minimum": 0},
              "downloads_30d": {"type": "integer", "minimum": 0},
              "stars": {"type": "integer", "minimum": 0},
              "downstream_citations": {"type": "array", "items": {"type": "string"}},
              "as_of": {"type": "string", "format": "date-time"},
              "sources": {"type": "array", "items": {"type": "string", "format": "uri"}},
              "methodology": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },

    "origin_id": {
      "type": "string",
      "description": "ULID or UUID linking this receipt to its origin idea in the IDEAS system. Optional — receipts without one are standalone ships."
    },
    "origin_timestamps": {
      "type": "object",
      "description": "Timestamps recording the idea-to-ship lifecycle stages. All fields optional.",
      "properties": {
        "idea": {
          "type": "string",
          "format": "date-time",
          "description": "When the originating idea was first captured."
        },
        "dispatched": {
          "type": "string",
          "format": "date-time",
          "description": "When the idea entered a work queue."
        },
        "issue_opened": {
          "type": "string",
          "format": "date-time",
          "description": "When it became a GitHub issue."
        },
        "shipped": {
          "type": "string",
          "format": "date-time",
          "description": "When the ship receipt was created (redundant with issued_at but explicit)."
        }
      },
      "additionalProperties": true
    },

    "issuer": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "url": {"type": "string", "format": "uri"}
      },
      "additionalProperties": true
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "format", "content_hash", "derived_from", "renderer"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "format": {"type": "string", "enum": ["png", "gif", "mp4", "ascii-gif", "ascii-mp4"]},
          "path": {"type": "string"},
          "uri": {"type": "string", "format": "uri"},
          "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "derived_from": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "label": {"type": "string"},
          "caption": {"type": "string"},
          "renderer": {
            "type": "object",
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "config_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true,
        "anyOf": [
          {"required": ["path"]},
          {"required": ["uri"]}
        ]
      }
    },
    "notes": {"type": "string"},

    "attestation": {
      "type": "object",
      "description": "Optional DR attestation embedded in this receipt. Links the ship receipt to a formal diminishing-returns quality attestation.",
      "properties": {
        "attestation_id": {
          "type": "string",
          "description": "ULID or UUID identifying this attestation."
        },
        "origin": {
          "type": "object",
          "properties": {
            "agent_id": {"type": "string"},
            "orcid": {"type": "string", "description": "ORCID identity anchor for the attesting agent."}
          },
          "additionalProperties": true
        },
        "evidence_hash": {
          "type": "string",
          "description": "SHA-256 hash of the attested evidence (mirrors content_hash at the attestation level)."
        },
        "score": {"type": "number"},
        "rounds": {"type": "integer", "minimum": 1},
        "method": {"type": "string"},
        "trust_level": {
          "type": "string",
          "enum": ["local", "federated", "internet"],
          "description": "Verification scope of this attestation."
        },
        "refs": {
          "type": "array",
          "description": "References to other attestations (DAG links).",
          "items": {"type": "string"}
        },
        "attested_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
